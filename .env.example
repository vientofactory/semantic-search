# LawCast semantic-search engine — optional environment file
#
# lawcast_semantic/config.py loads `.env` from the project root at import
# time (copy this file to `.env` to customize). The process environment
# always wins: docker-compose `environment:` and shell exports override
# these values. docker-compose injects this file into the sidecar at
# runtime via `env_file:` (required:false) — it is never baked into the
# Docker image, and a missing file is tolerated.
#
# Path override / kill switch: LAWCAST_SEMANTIC_ENV_FILE (empty value
# disables file loading entirely).
#
# Note: LAWCAST_SEMANTIC_ARTIFACTS_DIR is intentionally not set here. The
# host default resolves to ./artifacts; the Docker image sets
# /app/artifacts via its Dockerfile ENV instead.

LAWCAST_SEMANTIC_MODEL=dragonkue/BGE-m3-ko
# Embedding device: `auto` (default) probes for hardware faster than CPU at
# model load (CUDA > Apple MPS > Intel XPU) and falls back to cpu when none
# is usable — see lawcast_semantic/device.py. Pin `cpu` / `cuda` / `cuda:0` /
# `mps` to force a specific device (an unavailable pin degrades to cpu with
# a warning). The device never changes the vectors, so artifacts stay valid.
LAWCAST_SEMANTIC_DEVICE=auto
LAWCAST_SEMANTIC_BATCH=32
# 0 keeps unrestricted query embedding. Try 1 if concurrent Apple MPS
# searches have high tail latency. FAISS and corpus embedding are unaffected.
LAWCAST_SEMANTIC_MPS_QUERY_CONCURRENCY=0
# Optional split worker budgets for HTTP searches. A positive rank count
# enables separate embedding and FAISS/result-processing lanes. On MPS the
# existing positive MPS concurrency limit still caps embedding.
LAWCAST_SEMANTIC_QUERY_EMBED_WORKERS=4
LAWCAST_SEMANTIC_QUERY_RANK_WORKERS=0
# Relevance tiers (cosine similarity): below MIN is unrelated and dropped,
# between MIN and CLEAR is the weak band (served separately, hidden behind
# a reveal in the UI), at/above CLEAR is a clear result. MIN <= CLEAR.
LAWCAST_SEMANTIC_MIN_SIMILARITY=0.25
LAWCAST_SEMANTIC_CLEAR_SIMILARITY=0.45
# HTTP sidecar `GET /search` request bounds: query length cap (chars),
# chunk-window cap (k), default window when k is omitted. Must satisfy
# 1 <= DEFAULT_K <= MAX_K (a violation fails the config import at startup).
# Note: the MAX_K default (100) is pinned to the backend's
# SIDE_CAR_MAX_CHUNK_K by the cross-language contract spec, so overriding it
# requires raising that TypeScript constant in the same change.
LAWCAST_SEMANTIC_MAX_QUERY_LENGTH=500
LAWCAST_SEMANTIC_MAX_K=100

# 로컬 gRPC 테스트용 바인드 주소. Compose는 내부 포트 8301을 사용한다.
# LAWCAST_SEMANTIC_GRPC_BIND=127.0.0.1:8301
LAWCAST_SEMANTIC_DEFAULT_K=5
# 동일한 정규화 질의의 모델 벡터를 메모리에서 재사용한다. 0은 비활성화.
LAWCAST_SEMANTIC_QUERY_EMBED_CACHE_SIZE=256
# prepare_query_onnx.py로 검증한 CPU BGE-m3-ko 그래프 경로. 비우면 PyTorch를 사용한다.
LAWCAST_SEMANTIC_QUERY_ONNX_PATH=
LAWCAST_SEMANTIC_QUERY_ONNX_THREADS=2
LAWCAST_SEMANTIC_DB_PATH=
LAWCAST_SEMANTIC_UPDATE_CRON=0 * * * *
LAWCAST_SEMANTIC_ALLOW_LARGE_DELETE=false
LAWCAST_SEMANTIC_RELEVANCE_ENABLED=false
